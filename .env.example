# Environment variables for the lead-form proxy (netlify/functions/lead.js).
#
# These are NAMES ONLY. Real values live in the Netlify UI
# (Site configuration -> Environment variables) and are never committed.
# Copy this file to .env for local `netlify dev` runs; .env is gitignored.

# The n8n Webhook node's production URL. Self-hosted on the DigitalOcean
# droplet, so this is your own subdomain, e.g.
#   https://n8n.example.com/webhook/raf-lead
N8N_WEBHOOK_URL=

# Shared secret sent as the x-webhook-token header. The n8n workflow's
# first step should reject any request that doesn't carry it, so the
# webhook can't be driven directly by anyone who finds the URL.
# Generate one with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=
